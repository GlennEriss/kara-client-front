rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // FONCTIONS UTILITAIRES
    // ==========================================
    
    // Vérifie si l'utilisateur est authentifié
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Vérifie si l'utilisateur est admin (Admin, SuperAdmin ou Secretary)
    // Vérifie d'abord via custom claims (token.role), puis via collection admins
    function isAdmin() {
      return isAuthenticated() && (
        // Méthode 1 : Vérifier via custom claims (token.role)
        (request.auth.token.role != null && 
         request.auth.token.role in ['Admin', 'SuperAdmin', 'Secretary', 'Administrateur']) ||
        // Méthode 2 : Vérifier via collection admins (fallback si custom claims non définis)
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Vérifie si l'utilisateur est SuperAdmin.
    // Robuste au cas où le custom claim `role` est absent (ex. après migration
    // d'UID) : on retombe alors sur le tableau `roles` du document admins/users.
    function isSuperAdmin() {
      return isAuthenticated() && (
        // Méthode 1 : custom claim (token.role)
        request.auth.token.role == 'SuperAdmin' ||
        // Méthode 2 : tableau `roles` du document admins
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('roles', []).hasAny(['SuperAdmin'])) ||
        // Méthode 3 : tableau `roles` du document users
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('roles', []).hasAny(['SuperAdmin']))
      );
    }
    
    // Vérifie si le code de sécurité est valide pour modification par le demandeur
    function hasValidSecurityCode(requestData) {
      return requestData.securityCode != null &&
             requestData.securityCodeExpiry != null &&
             requestData.get('securityCodeUsed', false) == false &&
             request.time < requestData.securityCodeExpiry;
    }

    // Vérifie qu'un identifiant membre (matricule OU uid) appartient à l'utilisateur connecté.
    // Réutilisable pour toutes les collections où un document est rattaché à un membre.
    function isMemberOwner(memberId) {
      return isAuthenticated() && (
        memberId == request.auth.uid ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('matricule', '') == memberId)
      );
    }
    
    // Note: Chaque environnement (dev, preprod, prod) utilise sa propre base de données Firebase,
    // donc les noms de collections sont identiques dans tous les environnements.
    
    // ==========================================
    // COLLECTIONS GÉOGRAPHIQUES
    // ==========================================
    // Lecture publique pour permettre le remplissage du formulaire d'inscription
    // Écriture réservée aux admins
    
    match /provinces/{provinceId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /departments/{departmentId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /communes/{communeId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /districts/{districtId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /quarters/{quarterId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // ==========================================
    // STRUCTURE D'ADRESSES (ADDRESSES)
    // ==========================================
    // Structure hiérarchique des adresses (province -> ville -> arrondissement -> district)
    // Lecture publique pour permettre le remplissage du formulaire d'inscription
    // Écriture réservée aux admins
    
    match /addresses/{addressId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // ==========================================
    // UTILISATEURS (USERS)
    // ==========================================
    
    match /users/{userId} {
      // Lecture : Publique (nécessaire pour la connexion)
      allow read: if true;
      // Écriture : Admin uniquement (création lors de l'approbation)
      allow write: if isAdmin();
    }
    
    // ==========================================
    // MEMBRES (MEMBERS)
    // ==========================================
    
    match /members/{memberId} {
      // Lecture : Authentifié (pour afficher les informations des membres)
      allow read: if isAuthenticated();
      // Écriture : Admin uniquement
      allow write: if isAdmin();
    }

    // ==========================================
    // CAISSE SPÉCIALE – CACHE ÉLIGIBILITÉ CHARITY
    // ==========================================
    // Lecture : admins (module caisse spéciale)
    // Écriture : interdite au client (Cloud Function via Admin SDK)
    match /member-charity-summary/{memberId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    
    // ==========================================
    // DEMANDES D'ADHÉSION (MEMBERSHIP REQUESTS)
    // ==========================================
    
    match /membership-requests/{requestId} {

      // LECTURE : Publique (nécessaire pour les corrections via code de sécurité)
      // La sécurité est gérée côté application via le code de sécurité
      allow read: if true;

      // CRÉATION : Admin (ex. demandes migrées déjà approuvées) OU publique (validation stricte)
      allow create: if
        isAdmin() ||
        (
          // Champs obligatoires présents
          request.resource.data.keys().hasAll([
            'matricule',
            'status',
            'identity',
            'address',
            'documents',
            'createdAt'
          ]) &&
          // Statut initial imposé
          request.resource.data.status == 'pending' &&
          // Pas de tentative de se définir comme payé ou approuvé
          request.resource.data.get('isPaid', false) == false &&
          request.resource.data.get('processedBy', null) == null &&
          request.resource.data.get('approvedBy', null) == null
        );
      
      // MISE À JOUR : Admin ou demandeur avec code de sécurité valide
      allow update: if (
        // Cas 1: Admin - avec validation pour l'approbation, le rejet ET la réouverture
        (isAdmin() && (
          // Si le statut passe à 'approved', approvedBy et approvedAt doivent être présents
          (request.resource.data.status == 'approved' &&
           request.resource.data.approvedBy is string &&
           request.resource.data.approvedBy != null &&
           request.resource.data.approvedAt is timestamp &&
           request.resource.data.approvedAt != null &&
           // Protection : si déjà approuvé, empêcher la modification de approvedBy/approvedAt
           (resource.data.status != 'approved' ||
            (request.resource.data.approvedBy == resource.data.approvedBy &&
             request.resource.data.approvedAt == resource.data.approvedAt))) ||
          // Si le statut passe à 'rejected', processedBy, processedAt et motifReject doivent être présents
          (request.resource.data.status == 'rejected' &&
           request.resource.data.processedBy is string &&
           request.resource.data.processedBy != null &&
           request.resource.data.processedBy == request.auth.uid &&
           request.resource.data.processedAt is timestamp &&
           request.resource.data.processedAt != null &&
           request.resource.data.motifReject is string &&
           request.resource.data.motifReject.size() >= 10 &&
           request.resource.data.motifReject.size() <= 500 &&
           // Protection : si déjà rejeté, empêcher la modification de processedBy/processedAt/motifReject
           (resource.data.status != 'rejected' ||
            (request.resource.data.processedBy == resource.data.processedBy &&
             request.resource.data.motifReject == resource.data.motifReject))) ||
          // Si le statut passe de 'rejected' à 'pending' (réouverture)
          (resource.data.status == 'rejected' &&
           request.resource.data.status == 'pending' &&
           request.resource.data.reopenedBy is string &&
           request.resource.data.reopenedBy != null &&
           request.resource.data.reopenedBy == request.auth.uid &&
           request.resource.data.reopenedAt is timestamp &&
           request.resource.data.reopenedAt != null &&
           request.resource.data.reopenReason is string &&
           request.resource.data.reopenReason.size() >= 10 &&
           request.resource.data.reopenReason.size() <= 500 &&
           // Conserver le motifReject (ne pas le supprimer)
           request.resource.data.motifReject == resource.data.motifReject) ||
          // Sinon, mise à jour normale par admin
          (request.resource.data.status != 'approved' && 
           request.resource.data.status != 'rejected' &&
           !(resource.data.status == 'rejected' && request.resource.data.status == 'pending'))
        ))
      ) || (
        // Cas 2: Demandeur authentifié avec email correspondant et code de sécurité valide
        (isAuthenticated() &&
         resource.data.identity.email == request.auth.token.email &&
         hasValidSecurityCode(resource.data) &&
         // Ne peut pas modifier ces champs protégés
         request.resource.data.matricule == resource.data.matricule &&
         request.resource.data.status == resource.data.status &&
         request.resource.data.get('isPaid', false) == resource.data.get('isPaid', false) &&
         // Doit marquer le code comme utilisé
         request.resource.data.securityCodeUsed == true)
        ||
        // Cas 3: Demandeur non authentifié soumettant des corrections (via code de sécurité)
        // Vérification que :
        // - Le statut passe de 'under_review' à 'pending' (soumission corrections)
        // - Le code est marqué comme utilisé
        // - Le code et reviewNote sont nettoyés
        // - Le statut actuel est 'under_review' avec code non utilisé
        (resource.data.status == 'under_review' &&
         resource.data.get('securityCodeUsed', false) == false &&
         request.resource.data.status == 'pending' &&
         request.resource.data.securityCodeUsed == true &&
         (!('securityCode' in request.resource.data) || request.resource.data.securityCode == null) &&
         (!('reviewNote' in request.resource.data) || request.resource.data.reviewNote == null) &&
         // Ne peut pas modifier ces champs protégés
         request.resource.data.matricule == resource.data.matricule &&
         request.resource.data.get('isPaid', false) == resource.data.get('isPaid', false))
        ||
        // Cas 4 : Ajout des URLs de photos après soumission initiale (upload Storage en arrière-plan)
        // Pas d'authentification requise — sécurité assurée par la connaissance du matricule (ID doc)
        // Seuls les champs photo dans identity et documents peuvent être ajoutés
        (resource.data.status == 'pending' &&
         resource.data.state == 'IN_PROGRESS' &&
         // Champs immuables inchangés
         request.resource.data.matricule == resource.data.matricule &&
         request.resource.data.status == resource.data.status &&
         request.resource.data.state == resource.data.state &&
         request.resource.data.get('isPaid', false) == resource.data.get('isPaid', false) &&
         // Seuls identity, documents et updatedAt peuvent changer au niveau racine
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['identity', 'documents', 'updatedAt']) &&
         // Dans identity : seulement photoURL et photoPath
         (!(request.resource.data.diff(resource.data).affectedKeys().hasAny(['identity'])) ||
          request.resource.data.identity.diff(resource.data.identity).affectedKeys().hasOnly(['photoURL', 'photoPath'])) &&
         // Dans documents : seulement les champs photo
         (!(request.resource.data.diff(resource.data).affectedKeys().hasAny(['documents'])) ||
          request.resource.data.documents.diff(resource.data.documents).affectedKeys().hasOnly([
            'documentPhotoFrontURL', 'documentPhotoFrontPath',
            'documentPhotoBackURL', 'documentPhotoBackPath'
          ])))
      );
      
      // SUPPRESSION : Admin uniquement
      allow delete: if isAdmin();
    }
    
    // ==========================================
    // GROUPES DE DOUBLONS (DUPLICATE-GROUPS)
    // ==========================================
    // Détection automatique des doublons (téléphone, email, pièce d'identité)
    // Lecture : admins. Update : admins (résolution uniquement : resolvedAt, resolvedBy). Create/Delete : Cloud Functions.
    match /duplicate-groups/{groupId} {
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolvedAt', 'resolvedBy']);
      allow create, delete: if false;
    }

    // ==========================================
    // COLLECTION ADMINS
    // ==========================================
    // Lecture publique pour permettre la vérification d'unicité du matricule
    // Écriture réservée aux SuperAdmins
    
    match /admins/{adminId} {
      // Lecture publique (nécessaire pour vérifier l'unicité du matricule)
      allow read: if true;
      // Écriture réservée aux SuperAdmins (via claim OU tableau `roles` du doc)
      allow write: if isSuperAdmin();
    }

    // ==========================================
    // JOURNALISATION (audit des actions admin) — append-only
    // ==========================================
    match /auditLogs/{logId} {
      // Lecture réservée aux administrateurs
      allow read: if isAdmin();
      // Création uniquement (journal inaltérable) : pas de modification ni suppression
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // ==========================================
    // BOUTIQUES (annuaire des commerces des membres)
    // ==========================================
    match /shops/{shopId} {
      // Lecture par tout membre connecté (annuaire visible côté membre)
      allow read: if isAuthenticated();
      // Création / modification / suppression réservées aux admins
      allow write: if isAdmin();
    }
    
    // ==========================================
    // ABONNEMENTS (SUBSCRIPTIONS)
    // ==========================================
    
    match /subscriptions/{subscriptionId} {
      // Lecture : Admin ou propriétaire (userId = uid ou matricule ; portail membre utilise users/(uid).matricule)
      allow read: if isAdmin() ||
                     (isAuthenticated() && (
                       resource.data.userId == request.auth.uid ||
                       (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.matricule == resource.data.userId)
                     ));
      // Écriture : Admin uniquement
      allow write: if isAdmin();
    }
    
    // ==========================================
    // DOCUMENTS ARCHIVÉS
    // ==========================================
    
    match /documents/{documentId} {
      // Lecture : Admin ou propriétaire (via memberId)
      allow read: if isAdmin() ||
                     (isAuthenticated() && resource.data.memberId == request.auth.uid);
      // Création : Admin ou membre déposant son contrat signé CI ou CS
      allow create: if isAdmin() || (
        isAuthenticated() &&
        request.resource.data.type in ['MEMBER_SIGNED_CI', 'MEMBER_SIGNED_CS'] &&
        (request.resource.data.memberId == request.auth.uid ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('matricule', '') == request.resource.data.memberId))
      );
      // Mise à jour et suppression : Admin uniquement
      allow update, delete: if isAdmin();
    }
    
    // ==========================================
    // NOTIFICATIONS
    // ==========================================
    
    // Tokens de notification push (FCM) des deux applications.
    // Doc id = token. Chaque navigateur enregistre/rafraîchit/supprime le sien ;
    // la lecture client est inutile (la Cloud Function lit via l'Admin SDK).
    match /fcmTokens/{token} {
      allow read: if isAdmin();
      allow create, update: if isAuthenticated() &&
        request.resource.data.audience in ['admin', 'member'];
      allow delete: if isAuthenticated();
    }

    match /notifications/{notificationId} {
      // Lecture : Admin OU le membre destinataire (notifications avec recipientId).
      // Pour les LIST queries, le `where("recipientId", "==", X)` du client filtre déjà
      // les docs sans recipientId. On évite donc le .get('recipientId', '') qui perturbe
      // l'évaluation statique de la règle par Firestore.
      allow read: if isAdmin() || (
        isAuthenticated() &&
        resource.data.recipientId is string &&
        isMemberOwner(resource.data.recipientId)
      );
      // Création : Admin, Cloud Function (pas d'auth, ex. adhésion publique),
      // ou membre authentifié pour signaler ses propres demandes (isRead=false imposé)
      allow create: if
        isAdmin() ||
        request.auth == null ||
        (
          isAuthenticated() &&
          request.resource.data.isRead == false &&
          request.resource.data.module is string &&
          request.resource.data.type is string &&
          request.resource.data.title is string &&
          request.resource.data.message is string
        );
      // Mise à jour : Admin ou propriétaire (pour marquer comme lu uniquement)
      allow update: if isAdmin() || (
        isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readAt'])
      );
      // Suppression : Admin uniquement
      allow delete: if isAdmin();
    }
    
    // ==========================================
    // LOGS D'AUDIT (AUDIT-LOGS)
    // ==========================================
    // Logs d'audit créés par les Cloud Functions
    
    match /audit-logs/{logId} {
      // Lecture : Admin uniquement
      allow read: if isAdmin();
      // Création : Cloud Function uniquement (pas d'auth)
      allow create: if request.auth == null;
      // Mise à jour : Interdite (logs immutables)
      allow update: if false;
      // Suppression : SuperAdmin uniquement (via claim OU tableau `roles` du doc)
      allow delete: if isSuperAdmin();
    }
    
    // ==========================================
    // ENTREPRISES & PROFESSIONS (RÉFÉRENTIELS)
    // ==========================================
    
    match /companies/{companyId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /professions/{professionId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // ==========================================
    // COLLECTION CENTRALISÉE DES PAIEMENTS (PAYMENTS)
    // ==========================================
    // Historique centralisé de tous les versements
    // DONNÉES SENSIBLES - Accès restreint
    
    match /payments/{paymentId} {
      // LECTURE : Admins OU le membre concerné, identifié par l'un des champs
      // qui peuvent porter son matricule/uid selon le type de paiement.
      allow read: if isAdmin() || (
        isAuthenticated() && (
          (resource.data.get('memberId', '') != '' && isMemberOwner(resource.data.memberId)) ||
          (resource.data.get('beneficiaryId', '') != '' && isMemberOwner(resource.data.beneficiaryId)) ||
          (resource.data.get('sourceId', '') != '' && isMemberOwner(resource.data.sourceId))
        )
      );
      
      // CRÉATION : Admins uniquement avec validation des champs requis
      allow create: if isAdmin() &&
        // Champs obligatoires présents
        request.resource.data.keys().hasAll([
          'date',
          'time',
          'mode',
          'amount',
          'acceptedBy',
          'paymentType',
          'sourceType',
          'sourceId',
          'recordedBy',
          'recordedByName',
          'recordedAt',
          'createdAt'
        ]) &&
        // Validation des types
        request.resource.data.amount is number &&
        request.resource.data.amount > 0 &&
        request.resource.data.mode is string &&
        request.resource.data.sourceType is string &&
        request.resource.data.sourceId is string &&
        request.resource.data.recordedBy is string &&
        request.resource.data.recordedByName is string &&
        // Date de versement doit être valide
        request.resource.data.date is timestamp &&
        // Date d'enregistrement doit être valide
        request.resource.data.recordedAt is timestamp;
      
      // MISE À JOUR : Admins uniquement (pour corrections mineures)
      allow update: if isAdmin() &&
        // Ne peut pas modifier les champs critiques
        request.resource.data.amount == resource.data.amount &&
        request.resource.data.mode == resource.data.mode &&
        request.resource.data.date == resource.data.date &&
        request.resource.data.sourceType == resource.data.sourceType &&
        request.resource.data.sourceId == resource.data.sourceId &&
        request.resource.data.recordedBy == resource.data.recordedBy;
      
      // SUPPRESSION : Admins uniquement
      allow delete: if isAdmin();
    }
    
    // ==========================================
    // PARAMÈTRES CAISSE SPÉCIALE (CAISSE SETTINGS)
    // ==========================================
    // Lecture par subscribe() lors de la création de contrat depuis une demande
    match /caisseSettings/{settingsId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    
    // ==========================================
    // DEMANDES CAISSE SPÉCIALE (CAISSE SPECIALE DEMANDS) - V2
    // ==========================================
    // Page /caisse-speciale/demandes - Gestion des demandes de contrats CS
    // Workflows : ListerDemandes, FiltrerDemandes, RechercherDemandes, CreerDemande,
    //            AccepterDemande, RefuserDemande, ReouvrirDemande, ConvertirContrat,
    //            VoirDetails, ExporterDetailsDemande
    
    match /caisseSpecialeDemands/{demandId} {
      // LECTURE : Admin ou membre propriétaire (uid ou matricule)
      allow read: if isAdmin() ||
        (isAuthenticated() && isCaisseImprevueMember(resource.data.memberId));

      // CRÉATION : Admin OU membre authentifié créant sa propre demande
      allow create: if (
        // Cas 1 : Admin avec validation stricte
        isAdmin() &&
        request.resource.data.memberId is string &&
        request.resource.data.memberId.size() > 0 &&
        request.resource.data.contractType == 'INDIVIDUAL' &&
        request.resource.data.caisseType is string &&
        request.resource.data.caisseType in [
          'STANDARD', 'JOURNALIERE', 'LIBRE',
          'STANDARD_CHARITABLE', 'JOURNALIERE_CHARITABLE', 'LIBRE_CHARITABLE'
        ] &&
        request.resource.data.monthlyAmount is number &&
        request.resource.data.monthlyAmount >= 1000 &&
        request.resource.data.monthlyAmount <= 10000000 &&
        request.resource.data.monthsPlanned is number &&
        request.resource.data.monthsPlanned >= 1 &&
        request.resource.data.monthsPlanned <= 120 &&
        request.resource.data.desiredDate is string &&
        request.resource.data.desiredDate.size() > 0 &&
        request.resource.data.status == 'PENDING' &&
        request.resource.data.createdBy is string &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.updatedAt is timestamp &&
        !('approvedBy' in request.resource.data) &&
        !('approvedAt' in request.resource.data) &&
        !('rejectedBy' in request.resource.data) &&
        !('rejectedAt' in request.resource.data) &&
        !('reopenedBy' in request.resource.data) &&
        !('reopenedAt' in request.resource.data) &&
        !('convertedBy' in request.resource.data) &&
        !('convertedAt' in request.resource.data) &&
        !('contractId' in request.resource.data)
      ) || (
        // Cas 2 : Membre authentifié créant sa propre demande (portail membre)
        isAuthenticated() &&
        isCaisseImprevueMember(request.resource.data.memberId) &&
        // createdBy doit correspondre au memberId déclaré
        request.resource.data.createdBy == request.resource.data.memberId &&
        // Champs obligatoires
        request.resource.data.caisseType is string &&
        request.resource.data.caisseType in [
          'STANDARD', 'JOURNALIERE', 'LIBRE',
          'STANDARD_CHARITABLE', 'JOURNALIERE_CHARITABLE', 'LIBRE_CHARITABLE'
        ] &&
        request.resource.data.monthlyAmount is number &&
        request.resource.data.monthlyAmount >= 1000 &&
        request.resource.data.monthsPlanned is number &&
        request.resource.data.monthsPlanned >= 1 &&
        request.resource.data.desiredDate is string &&
        request.resource.data.desiredDate.size() > 0 &&
        request.resource.data.emergencyContact is map &&
        request.resource.data.emergencyContact.lastName is string &&
        request.resource.data.emergencyContact.lastName.size() > 0 &&
        request.resource.data.emergencyContact.phone1 is string &&
        request.resource.data.emergencyContact.phone1.size() > 0 &&
        // Statut initial et marqueur membre
        request.resource.data.status == 'PENDING' &&
        request.resource.data._submittedByMember == true &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.updatedAt is timestamp &&
        // Pas de champs de décision à la création
        !('approvedBy' in request.resource.data) &&
        !('approvedAt' in request.resource.data) &&
        !('rejectedBy' in request.resource.data) &&
        !('rejectedAt' in request.resource.data) &&
        !('contractId' in request.resource.data) &&
        !('convertedAt' in request.resource.data)
      );

      // MISE À JOUR : Admin (approbation, refus, réouverture, conversion) ou membre annulant sa propre demande PENDING
      allow update: if isAdmin() || (
        isAuthenticated() &&
        isCaisseImprevueMember(resource.data.memberId) &&
        resource.data.status == 'PENDING' &&
        request.resource.data.status == 'CANCELED' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
      );

      // SUPPRESSION : Admin (PENDING, APPROVED, REJECTED — pas CONVERTED) ; le superAdmin peut supprimer quel que soit le statut
      allow delete: if (isAdmin() && resource.data.status in ['PENDING', 'APPROVED', 'REJECTED']) || isSuperAdmin();
    }
    
    // ==========================================
    // CONTRATS CAISSE SPÉCIALE (CAISSE CONTRACTS)
    // ==========================================
    
    match /caisseContracts/{contractId} {
      // Lecture : Admin ou membre propriétaire (memberId = uid ou matricule du user)
      allow read: if isAdmin() ||
        (isAuthenticated() && (
          resource.data.memberId == request.auth.uid ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.matricule == resource.data.memberId)
        ));
      // Création : Admin uniquement + settingsVersion obligatoire
      allow create: if isAdmin() &&
        request.resource.data.settingsVersion is string &&
        request.resource.data.settingsVersion.size() > 0;
      // Mise à jour : Admin ou membre déposant son contrat signé
      allow update: if isAdmin() || (
        isAuthenticated() &&
        isCaisseImprevueMember(resource.data.memberId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberSignedStatus', 'memberSignedAt', 'memberSignedDocumentId']) &&
        request.resource.data.memberSignedStatus == 'PENDING_ADMIN'
      );
      // Suppression : Admin uniquement
      allow delete: if isAdmin();
      
      // Sous-collection : versements (échéances mensuelles)
      // Lecture : Admin ou membre propriétaire du contrat parent
      match /payments/{paymentId} {
        allow read: if isAdmin() ||
          (isAuthenticated() && (
            get(/databases/$(database)/documents/caisseContracts/$(contractId)).data.memberId == request.auth.uid ||
            (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.matricule ==
               get(/databases/$(database)/documents/caisseContracts/$(contractId)).data.memberId)
          ));
        allow write: if isAdmin();
      }
      
      // Sous-collection : versements déclarés par le membre (en attente de validation admin)
      match /declaredVersements/{versementId} {
        // Lecture : Admin ou membre propriétaire du contrat parent
        allow read: if isAdmin() || (
          isAuthenticated() &&
          isCaisseImprevueMember(get(/databases/$(database)/documents/caisseContracts/$(contractId)).data.memberId)
        );
        // Création : Admin ou membre pour son propre contrat
        allow create: if isAdmin() || (
          isAuthenticated() &&
          isCaisseImprevueMember(get(/databases/$(database)/documents/caisseContracts/$(contractId)).data.memberId) &&
          request.resource.data.status == 'PENDING_MEMBER' &&
          request.resource.data._submittedByMember == true &&
          request.resource.data.amount is number &&
          request.resource.data.amount > 0 &&
          request.resource.data.createdBy is string &&
          request.resource.data.createdAt is timestamp
        );
        allow update, delete: if isAdmin();
      }

      // Sous-collection : remboursements (retrait anticipé, remboursement final)
      match /refunds/{refundId} {
        // Lecture : Admin ou membre propriétaire du contrat parent
        allow read: if isAdmin() || (
          isAuthenticated() &&
          isCaisseImprevueMember(get(/databases/$(database)/documents/caisseContracts/$(contractId)).data.memberId)
        );
        // Création : Admin ou membre pour son propre contrat
        allow create: if isAdmin() || (
          isAuthenticated() &&
          isCaisseImprevueMember(get(/databases/$(database)/documents/caisseContracts/$(contractId)).data.memberId) &&
          request.resource.data.status == 'PENDING' &&
          request.resource.data._submittedByMember == true &&
          request.resource.data.type in ['EARLY', 'FINAL'] &&
          request.resource.data.reason is string &&
          request.resource.data.reason.size() >= 5 &&
          request.resource.data.withdrawalAmount is number &&
          request.resource.data.withdrawalAmount > 0 &&
          request.resource.data.createdBy is string &&
          request.resource.data.createdAt is timestamp
        );
        allow update, delete: if isAdmin();
      }
    }
    
    // ==========================================
    // CAISSE IMPRÉVUE - CONTRATS & DEMANDES (portail membre)
    // ==========================================
    // Collections caisseImprevueContracts / caisseImprevueRequests : lecture membre (uid ou matricule).
    // La fonction isCaisseImprevueMember est réutilisée plus bas pour contractsCI et caisseImprevueDemands.
    
    function isCaisseImprevueMember(contractMemberId) {
      return contractMemberId == request.auth.uid ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('matricule', '') == contractMemberId);
    }
    
    match /caisseImprevueContracts/{contractId} {
      allow read: if isAdmin() || (isAuthenticated() && isCaisseImprevueMember(resource.data.memberId));
      allow write: if isAdmin();
      match /payments/{paymentId} {
        allow read: if isAdmin() ||
          (isAuthenticated() && isCaisseImprevueMember(get(/databases/$(database)/documents/caisseImprevueContracts/$(contractId)).data.memberId));
        allow write: if isAdmin();
      }
    }
    
    match /caisseImprevueRequests/{requestId} {
      allow read: if isAdmin() || (isAuthenticated() && isCaisseImprevueMember(resource.data.memberId));
      allow write: if isAdmin();
      match /history/{eventId} {
        allow read: if isAdmin() ||
          (isAuthenticated() && isCaisseImprevueMember(get(/databases/$(database)/documents/caisseImprevueRequests/$(requestId)).data.memberId));
        allow write: if isAdmin();
      }
    }
    
    // ==========================================
    // FORFAITS CAISSE IMPRÉVUE (SUBSCRIPTIONS CI)
    // ==========================================
    
    match /subscriptionsCI/{subscriptionId} {
      // LECTURE : Admin ou utilisateur authentifié (pour le formulaire de demande)
      allow read: if isAdmin() || isAuthenticated();
      
      // CRÉATION : Admin uniquement avec validation
      allow create: if isAdmin() &&
        // Champs obligatoires présents
        request.resource.data.keys().hasAll([
          'id',
          'code',
          'amountPerMonth',
          'nominal',
          'durationInMonths',
          'penaltyRate',
          'penaltyDelayDays',
          'supportMin',
          'supportMax',
          'status',
          'createdBy',
          'createdAt',
          'updatedAt'
        ]) &&
        // Validation des types et valeurs
        request.resource.data.code is string &&
        request.resource.data.code.size() > 0 &&
        request.resource.data.code.size() <= 10 &&
        request.resource.data.amountPerMonth is number &&
        request.resource.data.amountPerMonth > 0 &&
        request.resource.data.nominal is number &&
        request.resource.data.nominal > 0 &&
        request.resource.data.durationInMonths is number &&
        request.resource.data.durationInMonths > 0 &&
        request.resource.data.penaltyRate is number &&
        request.resource.data.penaltyRate >= 0 &&
        request.resource.data.penaltyDelayDays is number &&
        request.resource.data.penaltyDelayDays >= 0 &&
        request.resource.data.supportMin is number &&
        request.resource.data.supportMin >= 0 &&
        request.resource.data.supportMax is number &&
        request.resource.data.supportMax >= request.resource.data.supportMin &&
        request.resource.data.status is string &&
        request.resource.data.status in ['ACTIVE', 'INACTIVE'] &&
        request.resource.data.createdBy is string &&
        request.resource.data.createdBy == request.auth.uid &&
        // L'ID du document doit correspondre à l'ID dans les données
        request.resource.data.id == subscriptionId &&
        // Timestamps serveur
        request.resource.data.createdAt is timestamp &&
        request.resource.data.updatedAt is timestamp;
      
      // MISE À JOUR : Admin uniquement avec validation
      allow update: if isAdmin() &&
        // Ne peut pas modifier l'ID
        request.resource.data.id == resource.data.id &&
        // Ne peut pas modifier le code (identifiant métier)
        request.resource.data.code == resource.data.code &&
        // Ne peut pas modifier createdBy et createdAt
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.createdAt == resource.data.createdAt &&
        // updatedBy doit être présent et correspondre à l'utilisateur
        request.resource.data.updatedBy is string &&
        request.resource.data.updatedBy == request.auth.uid &&
        // updatedAt doit être un timestamp serveur
        request.resource.data.updatedAt is timestamp &&
        // Validation des types et valeurs (même que pour create)
        request.resource.data.amountPerMonth is number &&
        request.resource.data.amountPerMonth > 0 &&
        request.resource.data.nominal is number &&
        request.resource.data.nominal > 0 &&
        request.resource.data.durationInMonths is number &&
        request.resource.data.durationInMonths > 0 &&
        request.resource.data.penaltyRate is number &&
        request.resource.data.penaltyRate >= 0 &&
        request.resource.data.penaltyDelayDays is number &&
        request.resource.data.penaltyDelayDays >= 0 &&
        request.resource.data.supportMin is number &&
        request.resource.data.supportMin >= 0 &&
        request.resource.data.supportMax is number &&
        request.resource.data.supportMax >= request.resource.data.supportMin &&
        request.resource.data.status is string &&
        request.resource.data.status in ['ACTIVE', 'INACTIVE'];
      
      // SUPPRESSION : Admin uniquement
      // Note: La suppression doit être effectuée avec précaution car les contrats existants
      // peuvent référencer ce forfait. Il est recommandé de désactiver (status='INACTIVE')
      // plutôt que de supprimer.
      allow delete: if isAdmin();
    }
    
    // ==========================================
    // ============================================
    // CAISSE IMPRÉVUE - DEMANDES (V2)
    // ============================================
    match /caisseImprevueDemands/{demandId} {
      // LECTURE : Admin ou propriétaire (membre)
      allow read: if isAdmin() ||
        (isAuthenticated() && isCaisseImprevueMember(resource.data.memberId));

      // CRÉATION : Admin OU membre authentifié créant sa propre demande
      allow create: if (
        // Cas 1 : Admin (validation stricte)
        isAdmin() &&
        request.resource.data.memberId is string &&
        request.resource.data.memberId.size() > 0 &&
        request.resource.data.memberFirstName is string &&
        request.resource.data.memberLastName is string &&
        request.resource.data.memberLastName.size() > 0 &&
        request.resource.data.cause is string &&
        request.resource.data.cause.size() >= 10 &&
        request.resource.data.cause.size() <= 500 &&
        request.resource.data.subscriptionCIID is string &&
        request.resource.data.subscriptionCIID.size() > 0 &&
        request.resource.data.subscriptionCICode is string &&
        request.resource.data.subscriptionCICode.size() > 0 &&
        request.resource.data.subscriptionCIAmountPerMonth is number &&
        request.resource.data.subscriptionCIAmountPerMonth > 0 &&
        request.resource.data.subscriptionCIDuration is number &&
        request.resource.data.subscriptionCIDuration > 0 &&
        request.resource.data.paymentFrequency in ['DAILY', 'MONTHLY'] &&
        ((request.resource.data.desiredStartDate is string &&
          request.resource.data.desiredStartDate.size() > 0) ||
         (request.resource.data.desiredDate is string &&
          request.resource.data.desiredDate.size() > 0)) &&
        request.resource.data.emergencyContact is map &&
        request.resource.data.emergencyContact.lastName is string &&
        request.resource.data.emergencyContact.lastName.size() > 0 &&
        request.resource.data.emergencyContact.phone1 is string &&
        request.resource.data.emergencyContact.phone1.size() > 0 &&
        request.resource.data.emergencyContact.relationship is string &&
        request.resource.data.emergencyContact.relationship.size() > 0 &&
        request.resource.data.emergencyContact.typeId is string &&
        request.resource.data.emergencyContact.typeId.size() > 0 &&
        request.resource.data.emergencyContact.idNumber is string &&
        request.resource.data.emergencyContact.idNumber.size() > 0 &&
        request.resource.data.status == 'PENDING' &&
        request.resource.data.createdBy is string &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.updatedAt is timestamp &&
        !('decisionReason' in request.resource.data) &&
        !('acceptedBy' in request.resource.data) &&
        !('acceptedAt' in request.resource.data) &&
        !('rejectedBy' in request.resource.data) &&
        !('rejectedAt' in request.resource.data) &&
        !('contractId' in request.resource.data) &&
        !('convertedAt' in request.resource.data) &&
        !('reopenReason' in request.resource.data) &&
        !('reopenedBy' in request.resource.data) &&
        !('reopenedAt' in request.resource.data)
      ) || (
        // Cas 2 : Membre authentifié créant sa propre demande (portail membre)
        // memberId peut être l'uid ou le matricule — isCaisseImprevueMember gère les deux cas
        isAuthenticated() &&
        isCaisseImprevueMember(request.resource.data.memberId) &&
        // createdBy = memberId (matricule ou uid selon le profil)
        request.resource.data.createdBy == request.resource.data.memberId &&
        // Validation des champs obligatoires
        request.resource.data.cause is string &&
        request.resource.data.cause.size() >= 10 &&
        request.resource.data.cause.size() <= 500 &&
        request.resource.data.subscriptionCIID is string &&
        request.resource.data.subscriptionCIID.size() > 0 &&
        request.resource.data.subscriptionCIAmountPerMonth is number &&
        request.resource.data.subscriptionCIAmountPerMonth > 0 &&
        request.resource.data.subscriptionCIDuration is number &&
        request.resource.data.subscriptionCIDuration > 0 &&
        request.resource.data.paymentFrequency in ['DAILY', 'MONTHLY'] &&
        request.resource.data.desiredStartDate is string &&
        request.resource.data.desiredStartDate.size() > 0 &&
        request.resource.data.emergencyContact is map &&
        request.resource.data.emergencyContact.lastName is string &&
        request.resource.data.emergencyContact.lastName.size() > 0 &&
        request.resource.data.emergencyContact.phone1 is string &&
        request.resource.data.emergencyContact.phone1.size() > 0 &&
        request.resource.data.emergencyContact.relationship is string &&
        request.resource.data.emergencyContact.relationship.size() > 0 &&
        // Statut initial obligatoirement PENDING
        request.resource.data.status == 'PENDING' &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.updatedAt is timestamp &&
        // Pas de champs de décision à la création
        !('decisionReason' in request.resource.data) &&
        !('acceptedBy' in request.resource.data) &&
        !('acceptedAt' in request.resource.data) &&
        !('rejectedBy' in request.resource.data) &&
        !('rejectedAt' in request.resource.data) &&
        !('contractId' in request.resource.data) &&
        !('convertedAt' in request.resource.data) &&
        !('reopenReason' in request.resource.data) &&
        !('reopenedBy' in request.resource.data) &&
        !('reopenedAt' in request.resource.data)
      );

      // MODIFICATION : Admin ou membre annulant sa propre demande PENDING
      allow update: if isAdmin() || (
        // Membre : annulation uniquement (PENDING → CANCELED, seuls status + updatedAt changent)
        isAuthenticated() &&
        isCaisseImprevueMember(resource.data.memberId) &&
        resource.data.status == 'PENDING' &&
        request.resource.data.status == 'CANCELED' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
      );

      // SUPPRESSION : Admin (demandes REJECTED uniquement) ; le superAdmin peut supprimer quel que soit le statut
      allow delete: if (isAdmin() && resource.data.status == 'REJECTED') || isSuperAdmin();
    }
    
    // ============================================
    // CAISSE IMPRÉVUE - FORFAITS (SUBSCRIPTIONS CI)
    // ============================================
    match /subscriptionsCI/{subscriptionId} {
      // ✅ Admins et utilisateurs authentifiés peuvent lire les forfaits
      // (nécessaire pour afficher les forfaits dans le formulaire Step 2)
      allow read: if isAdmin() || isAuthenticated();
      
      // Seulement admins peuvent créer/modifier/supprimer les forfaits
      allow write: if isAdmin();
    }
    
    // ============================================
    // CAISSE IMPRÉVUE - CONTRATS (contractsCI)
    // ============================================
    // isCaisseImprevueMember défini plus haut (bloc caisseImprevueContracts / caisseImprevueRequests).

    match /contractsCI/{contractId} {
      // Lecture : Admin ou propriétaire (membre)
      // Note: memberId est l'UID Firebase côté apps membres.
      allow read: if isAdmin() ||
        (isAuthenticated() && isCaisseImprevueMember(resource.data.memberId));

      // Création : Admin uniquement
      allow create: if isAdmin();

      // Mise à jour : Admin, ou membre pour des champs autorisés spécifiques
      allow update: if isAdmin() || (
        // Mise à jour currentSupportId après création d'une demande d'aide
        isAuthenticated() &&
        isCaisseImprevueMember(resource.data.memberId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentSupportId', 'updatedAt'])
      ) || (
        // Dépôt du contrat signé par le membre (en attente de validation admin)
        isAuthenticated() &&
        isCaisseImprevueMember(resource.data.memberId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberSignedDocumentId', 'memberSignedStatus', 'memberSignedAt']) &&
        request.resource.data.memberSignedStatus == 'PENDING_ADMIN'
      );

      allow delete: if isAdmin();

      // Sous-collection : versements/paiements par mois
      // Nécessaire pour /caisse-imprevue/contrats/[id] et /versements
      match /payments/{paymentId} {
        // Lecture : Admin ou propriétaire du contrat parent
        allow read: if isAdmin() || (
          isAuthenticated() &&
          isCaisseImprevueMember(get(/databases/$(database)/documents/contractsCI/$(contractId)).data.memberId)
        );
        allow create, update: if isAdmin();
        allow delete: if isAdmin();
      }

      // Sous-collection : demandes d'aide (supports)
      match /supports/{supportId} {
        allow read: if isAdmin() || (
          isAuthenticated() &&
          isCaisseImprevueMember(get(/databases/$(database)/documents/contractsCI/$(contractId)).data.memberId)
        );
        // Création : Admin ou membre pour son propre contrat (demande d'aide depuis portail membre)
        allow create: if isAdmin() || (
          isAuthenticated() &&
          isCaisseImprevueMember(get(/databases/$(database)/documents/contractsCI/$(contractId)).data.memberId) &&
          request.resource.data.status == 'PENDING_ADMIN' &&
          request.resource.data.amount is number &&
          request.resource.data.amount > 0 &&
          request.resource.data.createdBy is string &&
          request.resource.data.createdAt is timestamp
        );
        allow update, delete: if isAdmin();
      }

      match /earlyRefunds/{refundId} {
        allow read: if isAdmin() || (
          isAuthenticated() &&
          isCaisseImprevueMember(get(/databases/$(database)/documents/contractsCI/$(contractId)).data.memberId)
        );
        // Création : Admin ou membre pour son propre contrat (demande de retrait depuis portail membre)
        allow create: if isAdmin() || (
          isAuthenticated() &&
          isCaisseImprevueMember(get(/databases/$(database)/documents/contractsCI/$(contractId)).data.memberId) &&
          request.resource.data.status == 'PENDING' &&
          request.resource.data._submittedByMember == true &&
          request.resource.data.reason is string &&
          request.resource.data.reason.size() >= 10 &&
          request.resource.data.withdrawalAmount is number &&
          request.resource.data.withdrawalAmount > 0 &&
          request.resource.data.createdBy is string &&
          request.resource.data.createdAt is timestamp
        );
        allow update, delete: if isAdmin();
      }

      // Sous-collection : versements déclarés par le MEMBRE (app membre),
      // en attente de validation par un gestionnaire (même flux que la CS).
      match /declaredVersements/{versementId} {
        // Lecture : Admin ou membre propriétaire du contrat parent
        allow read: if isAdmin() || (
          isAuthenticated() &&
          isCaisseImprevueMember(get(/databases/$(database)/documents/contractsCI/$(contractId)).data.memberId)
        );
        // Création : membre pour son propre contrat, uniquement en attente
        allow create: if isAdmin() || (
          isAuthenticated() &&
          isCaisseImprevueMember(get(/databases/$(database)/documents/contractsCI/$(contractId)).data.memberId) &&
          request.resource.data.status == 'PENDING_MEMBER' &&
          request.resource.data._submittedByMember == true &&
          request.resource.data.amount is number &&
          request.resource.data.amount > 0 &&
          request.resource.data.memberId is string &&
          request.resource.data.createdAt is timestamp
        );
        allow update, delete: if isAdmin();
      }
    }
    
    // ==========================================
    // CRÉDIT SPÉCIALE - DEMANDES (CREDIT DEMANDS)
    // ==========================================
    // Page /credit-speciale/demandes - Gestion des demandes de crédit (spéciale, fixe, aide)

    match /creditDemands/{demandId} {
      // LECTURE : Admin ou propriétaire de la demande (uid ou matricule)
      allow read: if isAdmin() ||
        (isAuthenticated() && isCaisseImprevueMember(resource.data.clientId));

      // CRÉATION : Admin OU membre authentifié créant sa propre demande
      allow create: if (
        // Cas 1 : Admin avec validation stricte
        isAdmin() &&
        request.resource.data.clientId is string &&
        request.resource.data.clientId.size() > 0 &&
        request.resource.data.clientFirstName is string &&
        request.resource.data.clientLastName is string &&
        request.resource.data.creditType in ['SPECIALE', 'FIXE', 'AIDE'] &&
        request.resource.data.amount is number &&
        request.resource.data.amount >= 1000 &&
        request.resource.data.desiredDate is string &&
        request.resource.data.desiredDate.size() > 0 &&
        request.resource.data.cause is string &&
        request.resource.data.cause.size() >= 10 &&
        request.resource.data.cause.size() <= 500 &&
        request.resource.data.status == 'PENDING' &&
        request.resource.data.createdBy is string &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.updatedAt is timestamp
      ) || (
        // Cas 2 : Membre authentifié créant sa propre demande (portail membre)
        isAuthenticated() &&
        isCaisseImprevueMember(request.resource.data.clientId) &&
        request.resource.data.createdBy == request.resource.data.clientId &&
        // Champs obligatoires
        request.resource.data.creditType in ['SPECIALE', 'FIXE', 'AIDE'] &&
        request.resource.data.desiredDate is string &&
        request.resource.data.desiredDate.size() > 0 &&
        request.resource.data.cause is string &&
        request.resource.data.cause.size() >= 10 &&
        request.resource.data.cause.size() <= 500 &&
        // Statut initial obligatoirement PENDING
        request.resource.data.status == 'PENDING' &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.updatedAt is timestamp &&
        // Pas de champs de décision à la création
        !('approvedBy' in request.resource.data) &&
        !('approvedAt' in request.resource.data) &&
        !('rejectedBy' in request.resource.data) &&
        !('rejectedAt' in request.resource.data) &&
        !('contractId' in request.resource.data)
      );

      // MISE À JOUR : Admin, ou membre annulant sa propre demande PENDING
      allow update: if isAdmin() || (
        isAuthenticated() &&
        isCaisseImprevueMember(resource.data.clientId) &&
        resource.data.status == 'PENDING' &&
        request.resource.data.status == 'CANCELED' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
      );

      // SUPPRESSION : Admin (demandes PENDING sans contrat lié) ; le superAdmin peut supprimer quel que soit le statut
      allow delete: if (isAdmin() &&
        resource.data.status == 'PENDING' &&
        (!('contractId' in resource.data) || resource.data.get('contractId', null) == null))
        || isSuperAdmin();
    }
    
    // ==========================================
    // CRÉDIT SPÉCIALE - CONTRATS (CREDIT CONTRACTS)
    // Validation des transitions DISCHARGED et CLOSED (clôture de contrat)
    // Suppression de contrat (V2) : admin uniquement, contrats PENDING/DRAFT sans versement (vérifié côté service)
    // ==========================================
    match /creditContracts/{contractId} {
      allow read: if isAdmin() ||
        (isAuthenticated() && isCaisseImprevueMember(resource.data.clientId));
      allow create: if isAdmin();
      allow update: if isAdmin() && (
        // Transition vers DISCHARGED : motif obligatoire (10-500 car.), dischargedBy = admin, dischargedAt timestamp
        // Ou : contrat déjà DISCHARGED (mise à jour partielle ex. signedQuittanceUrl)
        (request.resource.data.status != 'DISCHARGED' ||
         (resource.data.status == 'DISCHARGED') ||
         (resource.data.status != 'DISCHARGED' &&
          request.resource.data.dischargeMotif is string &&
          request.resource.data.dischargeMotif.size() >= 10 &&
          request.resource.data.dischargeMotif.size() <= 500 &&
          request.resource.data.dischargedBy is string &&
          request.resource.data.dischargedBy == request.auth.uid &&
          request.resource.data.dischargedAt is timestamp)) &&
        // Transition vers CLOSED : contrat DISCHARGED, quittance signée, motif obligatoire
        // Ou : contrat déjà CLOSED (mise à jour partielle)
        (request.resource.data.status != 'CLOSED' ||
         (resource.data.status == 'CLOSED') ||
         (resource.data.status == 'DISCHARGED' &&
          request.resource.data.signedQuittanceUrl is string &&
          request.resource.data.signedQuittanceUrl.size() > 0 &&
          request.resource.data.motifCloture is string &&
          request.resource.data.motifCloture.size() >= 10 &&
          request.resource.data.motifCloture.size() <= 500 &&
          request.resource.data.closedBy is string &&
          request.resource.data.closedBy == request.auth.uid &&
          request.resource.data.closedAt is timestamp))
      );
      // Suppression : admin uniquement (supprimer contrat crédit spéciale V2 — éligibilité PENDING/DRAFT + amountPaid=0 côté service)
      allow delete: if isAdmin();
    }
    
    // ==========================================
    // CRÉDIT SPÉCIALE - ÉCHÉANCES (CREDIT INSTALLMENTS)
    // ==========================================
    
    match /creditInstallments/{installmentId} {
      allow read, write: if isAdmin();
    }

    // ==========================================
    // CRÉDIT SPÉCIALE - PAIEMENTS (CREDIT PAYMENTS)
    // ==========================================

    match /creditPayments/{paymentId} {
      allow read, write: if isAdmin();
    }
    
    // ==========================================
    // CRÉDIT SPÉCIALE - PÉNALITÉS (CREDIT PENALTIES)
    // ==========================================
    
    match /creditPenalties/{penaltyId} {
      allow read, write: if isAdmin();
    }
    
    // ==========================================
    // CRÉDIT SPÉCIALE - RÉMUNÉRATIONS GARANTS (GUARANTOR REMUNERATIONS)
    // ==========================================
    
    match /guarantorRemunerations/{remunerationId} {
      allow read, write: if isAdmin();
    }

    // ==========================================
    // CRÉDIT SPÉCIALE - PAIEMENTS AUX GARANTS (GUARANTOR PAYMENTS)
    // ==========================================
    
    match /guarantorPayments/{paymentId} {
      allow read, write: if isAdmin();
    }
    
    // ==========================================
    // CHARITÉS / BIENFAITEUR (CHARITY EVENTS)
    // ==========================================
    // Page /bienfaiteur, /bienfaiteur/[id] : évènements, participants, contributions, médias
    // Utilisé aussi par MemberActivitySummary sur /credit-speciale/demandes/[id]
    
    match /charity-events/{eventId} {
      allow read: if isAdmin() || isAuthenticated();
      allow write: if isAdmin();
      
      match /contributions/{contributionId} {
        allow read: if isAdmin() || isAuthenticated();
        allow write: if isAdmin();
      }
      
      match /participants/{participantId} {
        allow read: if isAdmin() || isAuthenticated();
        allow write: if isAdmin();
      }
      
      // Médias d'un évènement (photos / vidéos) - onglet Médias sur /bienfaiteur/[id]
      match /media/{mediaId} {
        allow read: if isAdmin() || isAuthenticated();
        allow write: if isAdmin();
      }
    }

    // Déclarations d'intention de contribution des MEMBRES (app membre).
    // Le membre déclare (status "pending") ; un gestionnaire confirme ou refuse
    // depuis la fiche évènement admin (la contribution réelle est alors créée
    // dans charity-events/{id}/contributions).
    match /charityContributions/{declarationId} {
      allow read: if isAdmin() || isAuthenticated();
      // Création par un membre connecté, uniquement en "pending".
      allow create: if isAuthenticated() && request.resource.data.status == 'pending';
      // Validation / refus réservés aux gestionnaires.
      allow update, delete: if isAdmin();
    }

    // ==========================================
    // PLACEMENTS (MEMBER ACTIVITY SUMMARY)
    // ==========================================
    // Utilisé par MemberActivitySummary sur /credit-speciale/demandes/[id]
    
    match /placements/{placementId} {
      allow read: if isAdmin() || isAuthenticated();
      allow write: if isAdmin();
      
      match /commissions/{commissionId} {
        allow read, write: if isAdmin();
      }
    }
    
    match /placementDemands/{demandId} {
      allow read: if isAdmin() || isAuthenticated();
      allow write: if isAdmin();
    }
    
    // ==========================================
    // GROUPES (CHARITY CONTRIBUTION SERVICE)
    // ==========================================
    // Utilisé par CharityContributionService pour enrichir les contributions
    
    match /groups/{groupId} {
      allow read: if isAdmin() || isAuthenticated();
      allow write: if isAdmin();
    }
    
    // ==========================================
    // AGENTS DE RECOUVREMENT (AGENTS RECOUVREMENT)
    // ==========================================
    // Gestion des agents de recouvrement (création, modification, désactivation)
    // Utilisé par : Page /admin/agents-recouvrement, modals Créer/Modifier/Désactiver
    // Sélection dans : CreditPaymentModal, Caisse spéciale pay(), Caisse imprévue createVersement()
    // Cloud Function : agentRecouvrementNotifications (lecture Admin SDK)
    
    match /agentsRecouvrement/{agentId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ==========================================
    // VÉHICULES - ASSURANCES (VEHICLE INSURANCES)
    // ==========================================
    // Page /vehicules, /vehicules/[id], /vehicules/[id]/edit
    // Gestion complète des assurances véhicules (CRUD, renouvellement, stats)
    match /vehicle-insurances/{insuranceId} {
      // Lecture : admin OU le membre propriétaire du véhicule
      allow read: if isAdmin() || (
        isAuthenticated() &&
        resource.data.memberId is string &&
        isMemberOwner(resource.data.memberId)
      );
      // Création : admin OU le membre qui déclare son propre véhicule
      // (memberId doit pointer vers lui-même + holderType doit être 'member')
      allow create: if isAdmin() || (
        isAuthenticated() &&
        request.resource.data.holderType == 'member' &&
        request.resource.data.memberId is string &&
        isMemberOwner(request.resource.data.memberId)
      );
      allow update: if isAdmin();
      allow delete: if isAdmin();

      // Sous-collections éventuelles (journal/audit/annexes)
      match /{subCollection=**} {
        allow read, write: if isAdmin();
      }
    }
    
    // ==========================================
    // ÉVÉNEMENTS (EVENTS)
    // ==========================================
    // Collection events : admin CRUD complet
    // Membres : lecture des événements publiés/ouverts/confirmés/terminés/annulés
    // Sous-collection votes/{memberId} : lecture admin + votant lui-même
    //   Écriture : le membre pour son propre vote si sondage ouvert

    match /events/{eventId} {
      // Lecture : admin toujours ; membre si l'événement n'est pas en brouillon
      allow read: if isAdmin() || (
        isAuthenticated() &&
        resource.data.status in ['published', 'poll_open', 'location_confirmed', 'completed', 'cancelled']
      );
      // Création, suppression : admin uniquement
      allow create, delete: if isAdmin();
      // Mise à jour : admin toujours ; membre uniquement pour les compteurs de vote
      allow update: if isAdmin() || (
        isAuthenticated() &&
        resource.data.status == 'poll_open' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votesByOptionId', 'totalVotes'])
      );

      // Votes : sous-collection events/{eventId}/votes/{memberId}
      match /votes/{memberId} {
        // Lecture : admin (tous les votes) ou le votant lui-même
        allow read: if isAdmin() || (
          isAuthenticated() && isMemberOwner(memberId)
        );
        // Écriture : le membre pour son propre vote, seulement si le sondage est ouvert
        allow write: if isAuthenticated() &&
          isMemberOwner(memberId) &&
          get(/databases/$(database)/documents/events/$(eventId)).data.status == 'poll_open';
      }
    }

    // ==========================================
    // RÈGLE PAR DÉFAUT
    // ==========================================
    // Refuser tout accès non explicitement autorisé

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
