rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ==========================================
    // FONCTIONS UTILITAIRES
    // ==========================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.role != null &&
         request.auth.token.role in ['Admin', 'SuperAdmin', 'Secretary', 'Administrateur'])
      );
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isPDF() {
      return request.resource.contentType == 'application/pdf';
    }

    function isImageSizeValid() {
      return request.resource.size < 5 * 1024 * 1024;
    }

    function isPDFSizeValid() {
      return request.resource.size < 10 * 1024 * 1024;
    }

    function isContractPDFSizeValid() {
      return request.resource.size < 5 * 1024 * 1024;
    }

    // ==========================================
    // PHOTOS DE PROFIL (MEMBERSHIP-PHOTOS)
    // ==========================================

    match /membership-photos/{fileName} {
      allow read: if true;
      allow write: if isImage() && isImageSizeValid();
      allow delete: if isAdmin();
    }

    // ==========================================
    // DOCUMENTS D'IDENTITÉ (MEMBERSHIP-DOCUMENTS)
    // ==========================================

    match /membership-documents/{requestId}/{fileName} {
      allow read: if true;
      allow write: if isImage() && isImageSizeValid();
      allow delete: if true;
    }

    // ==========================================
    // PDFs D'ADHÉSION (MEMBERSHIP-ADHESION-PDFS)
    // ==========================================

    match /membership-adhesion-pdfs/{allPaths=**} {
      allow read: if isAdmin();
      allow write: if isAdmin() && isPDF() && isPDFSizeValid();
      allow delete: if isAdmin();
    }

    // ==========================================
    // DOCUMENTS GÉNÉRIQUES PAR MODULE
    // ==========================================

    match /documents/{module}/{memberId}/{fileName} {
      allow read: if isAdmin() || request.auth.uid == memberId;
      allow write: if isAdmin();
      allow delete: if isAdmin();
    }

    // ==========================================
    // PREUVES DE PAIEMENT (PAYMENT-PROOFS)
    // ==========================================

    match /payment-proofs/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated() && isImage() && isImageSizeValid();
      allow delete: if isAdmin();
    }

    // ==========================================
    // DOCUMENTS CONTRATS (CONTRACTS-CI) + CRÉDIT SPÉCIALE
    // ==========================================

    match /contracts-ci/{memberId}/{fileName} {
      allow read: if isAdmin() || (
        isAuthenticated() && (
          request.auth.uid == memberId ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('matricule', '') == memberId)
        )
      );
      allow write: if isAdmin() && (
        (isPDF() && isContractPDFSizeValid()) ||
        (isImage() && isImageSizeValid())
      );
      allow delete: if isAdmin();
    }

    match /contracts-ci/refunds/{contractId}/{refundId}/{fileName} {
      allow read: if isAdmin();
      allow write: if isAdmin() && isImage() && request.resource.size < 20 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    match /contracts-ci/{memberId}/{contractId}/{fileName} {
      allow read: if isAdmin() || (
        isAuthenticated() && (
          request.auth.uid == memberId ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('matricule', '') == memberId)
        )
      );
      allow write: if isAdmin() && isImage() && isImageSizeValid();
      allow delete: if isAdmin();
    }

    // ==========================================
    // CAISSE SPÉCIALE - PREUVES DE PAIEMENT ET REMBOURSEMENTS
    // ==========================================

    match /caisse/{contractId}/payments/{paymentId}/{fileName} {
      allow read: if isAdmin();
      allow write: if isAdmin() && isImage() && isImageSizeValid();
      allow delete: if isAdmin();
    }

    match /caisse/{contractId}/payments/{paymentId}/contributions/{fileName} {
      allow read: if isAdmin();
      allow write: if isAdmin() && isImage() && isImageSizeValid();
      allow delete: if isAdmin();
    }

    match /caisse/{contractId}/refunds/{refundId}/{fileName} {
      allow read: if isAdmin();
      allow write: if isAdmin() && (
        (isPDF() && isContractPDFSizeValid()) ||
        (isImage() && isImageSizeValid())
      );
      allow delete: if isAdmin();
    }

    // ==========================================
    // DOCUMENTS DE REMBOURSEMENT (CONTRACT-DOCUMENTS)
    // ==========================================

    match /contract-documents/{contractId}/{refundId}/{fileName} {
      allow read: if isAdmin();
      allow write: if isAdmin() && isPDF() && isPDFSizeValid();
      allow delete: if isAdmin();
    }

    // ==========================================
    // CAISSE SPÉCIALE - CONTRATS PDF
    // ==========================================

    match /contracts/{contractId}/{fileName} {
      allow read: if isAdmin();
      allow write: if isAdmin() && isPDF() && isPDFSizeValid();
      allow delete: if isAdmin();
    }

    // ==========================================
    // CRÉDIT SPÉCIALE - CONTRATS PDF (FALLBACK)
    // ==========================================

    match /credit-contracts/{contractId}/{fileName} {
      allow read: if isAdmin();
      allow write: if isAdmin() && isPDF() && isPDFSizeValid();
      allow delete: if isAdmin();
    }

    // ============================================
    // CAISSE SPÉCIALE - CONTACTS D'URGENCE (ADMIN)
    // ============================================

    match /emergency-contacts/{fileName} {
      allow read: if isAdmin();
      allow write: if isAdmin() &&
        request.resource.contentType.matches('image/(jpeg|jpg|png|webp)') &&
        request.resource.size < 5 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    // ============================================
    // CAISSE IMPRÉVUE - CONTACTS D'URGENCE (ADMIN)
    // ============================================

    match /emergency-contacts-ci/{fileName} {
      allow read: if true;
      allow write: if isAdmin() &&
        request.resource.contentType.matches('image/(jpeg|jpg|png|webp)') &&
        request.resource.size < 5 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    // ==========================================
    // BIENFAITEUR / CHARITÉS (CHARITY EVENTS)
    // ==========================================

    match /charity-events/covers/{fileName} {
      allow read: if isAdmin() || isAuthenticated();
      allow write: if isAdmin() && isImage() && isImageSizeValid();
      allow delete: if isAdmin();
    }

    match /charity-events/{eventId}/contributions/{fileName} {
      allow read: if isAdmin() || isAuthenticated();
      allow write: if isAdmin() && (
        (isImage() && isImageSizeValid()) ||
        (isPDF() && isPDFSizeValid())
      );
      allow delete: if isAdmin();
    }

    match /charity-events/{eventId}/media/{fileName} {
      allow read: if isAdmin() || isAuthenticated();
      allow write: if isAdmin() && (
        (isImage() && isImageSizeValid()) ||
        (request.resource.contentType.matches('video/.*') && request.resource.size < 50 * 1024 * 1024)
      );
      allow delete: if isAdmin();
    }

    // ==========================================
    // PHOTOS AGENTS DE RECOUVREMENT
    // ==========================================

    match /agents-recouvrement/{agentId}/{fileName} {
      allow read: if isAdmin();
      allow write: if isAdmin() &&
        request.resource.contentType.matches('image/(jpeg|jpg|png|webp)') &&
        request.resource.size < 5 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    // ==========================================
    // PORTAIL MEMBRE — INSCRIPTION (ADHÉSION)
    // ==========================================
    // Photos et documents uploadés lors de la demande d'adhésion
    // Chemins générés par uploadDataUrlToStorage :
    //   membership-request-profile-photo/{userId}/{matricule}/{filename}
    //   membership-request-document-front/{userId}/{matricule}/{filename}
    //   membership-request-document-back/{userId}/{matricule}/{filename}

    match /membership-request-profile-photo/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && isImage() && isImageSizeValid();
      allow delete: if isAdmin();
    }

    match /membership-request-document-front/{allPaths=**} {
      allow read: if isAdmin() || isAuthenticated();
      allow write: if isAuthenticated() && isImage() && isImageSizeValid();
      allow delete: if isAdmin();
    }

    match /membership-request-document-back/{allPaths=**} {
      allow read: if isAdmin() || isAuthenticated();
      allow write: if isAuthenticated() && isImage() && isImageSizeValid();
      allow delete: if isAdmin();
    }

    // ==========================================
    // PORTAIL MEMBRE — CAISSE IMPRÉVUE (CI)
    // ==========================================
    // Uploads effectués par les membres depuis kara-members-front
    // Chemins générés par uploadDataUrlToStorage :
    //   {category}/{userId}/{contractId}/{filename}

    // Photo pièce d'identité du contact d'urgence (demande CI)
    match /emergency-contact-ci/{allPaths=**} {
      allow read: if isAdmin() || isAuthenticated();
      allow write: if isAuthenticated() && isImage() && isImageSizeValid();
      allow delete: if isAdmin();
    }

    // Preuve de versement déclaré
    match /declared-versement-proof/{allPaths=**} {
      allow read: if isAdmin() || isAuthenticated();
      allow write: if isAuthenticated() && isImage() && isImageSizeValid();
      allow delete: if isAdmin();
    }

    // Preuve retrait anticipé CI
    match /early-refund-proof/{allPaths=**} {
      allow read: if isAdmin() || isAuthenticated();
      allow write: if isAuthenticated() && isImage() && isImageSizeValid();
      allow delete: if isAdmin();
    }

    // Preuve remboursement final CI
    match /final-refund-proof/{allPaths=**} {
      allow read: if isAdmin() || isAuthenticated();
      allow write: if isAuthenticated() && isImage() && isImageSizeValid();
      allow delete: if isAdmin();
    }

    // Document signé retrait anticipé CI (image ou PDF)
    match /early-refund-signed/{allPaths=**} {
      allow read: if isAdmin() || isAuthenticated();
      allow write: if isAuthenticated() && (
        (isImage() && isImageSizeValid()) ||
        (isPDF() && isPDFSizeValid())
      );
      allow delete: if isAdmin();
    }

    // Document signé remboursement final CI (image ou PDF)
    match /final-refund-signed/{allPaths=**} {
      allow read: if isAdmin() || isAuthenticated();
      allow write: if isAuthenticated() && (
        (isImage() && isImageSizeValid()) ||
        (isPDF() && isPDFSizeValid())
      );
      allow delete: if isAdmin();
    }

    // Contrat signé par le membre CI (en attente de validation admin)
    match /contrat-signe-ci/{allPaths=**} {
      allow read: if isAdmin() || isAuthenticated();
      allow write: if isAuthenticated() && isPDF() && isPDFSizeValid();
      allow delete: if isAdmin();
    }

    // Document signé demande d'aide CI (image ou PDF)
    match /support-ci-signed/{allPaths=**} {
      allow read: if isAdmin() || isAuthenticated();
      allow write: if isAuthenticated() && (
        (isImage() && isImageSizeValid()) ||
        (isPDF() && isPDFSizeValid())
      );
      allow delete: if isAdmin();
    }

    // ==========================================
    // PORTAIL MEMBRE — CAISSE SPÉCIALE (CS)
    // ==========================================

    match /cs-declared-versement-proof/{allPaths=**} {
      allow read: if isAdmin() || isAuthenticated();
      allow write: if isAuthenticated() && isImage() && isImageSizeValid();
      allow delete: if isAdmin();
    }

    match /cs-early-refund-proof/{allPaths=**} {
      allow read: if isAdmin() || isAuthenticated();
      allow write: if isAuthenticated() && isImage() && isImageSizeValid();
      allow delete: if isAdmin();
    }

    match /cs-final-refund-proof/{allPaths=**} {
      allow read: if isAdmin() || isAuthenticated();
      allow write: if isAuthenticated() && isImage() && isImageSizeValid();
      allow delete: if isAdmin();
    }

    match /cs-early-refund-signed/{allPaths=**} {
      allow read: if isAdmin() || isAuthenticated();
      allow write: if isAuthenticated() && (
        (isImage() && isImageSizeValid()) ||
        (isPDF() && isPDFSizeValid())
      );
      allow delete: if isAdmin();
    }

    match /cs-final-refund-signed/{allPaths=**} {
      allow read: if isAdmin() || isAuthenticated();
      allow write: if isAuthenticated() && (
        (isImage() && isImageSizeValid()) ||
        (isPDF() && isPDFSizeValid())
      );
      allow delete: if isAdmin();
    }

    // ==========================================
    // RÈGLE PAR DÉFAUT
    // ==========================================

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
